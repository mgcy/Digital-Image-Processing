   cooef = np.maximum(cooef1,cooef2)\n","    else:\n","        raise Exception(\"Choose one of the following fusion method: mean, min, max\")\n","    return cooef\n","\n","workpath = '/content/drive/MyDrive/DigitalImageProcessing/'\n","\n","# Params\n","FUSION_METHOD = 'mean' # Can be 'min' || 'max || anything you choose according theory\n","\n","# Read the two image\n","I1 = np.load(workpath + 'Data/new_array_vis.npy')\n","I2 = np.load(workpath + 'Data/new_array_ir.npy')\n","\n","# max-min-normalize\n","I1 = (I1 - np.min(I1)) / (np.max(I1) - np.min(I1) )\n","I2 = (I2 - np.min(I2)) / (np.max(I2) - np.min(I2) )\n","\n","# mean-std-normalize\n","# I1 = (I1 - np.mean(I1)) / np.std(I1)\n","# I2 = (I2 - np.mean(I2)) / np.std(I2)\n","\n","# DWT on each image\n","wavelet = 'db1'\n","cooef1 = pywt.wavedec2(I1[:,:], wavelet, level=2)\n","cooef2 = pywt.wavedec2(I2[:,:], wavelet, level=2)\n","\n","# Second: for each level in both image do the fusion according to the desire option\n","fusedCooef = []\n","for i in range(len(cooef1)):\n","\n","    # The first values in each decomposition is the apprximation values of the top level\n","    if(i == 0):\n","\n","        fusedCooef.append(fuseCoeff(cooef1[0],cooef2[0],FUSION_METHOD))\n","\n","    else:\n","\n","        # For the rest of the levels we have tupels with 3 coeeficents\n","        c1 = fuseCoeff(cooef1[i][0],cooef2[i][0],FUSION_METHOD)\n","        c2 = fuseCoeff(cooef1[i][1], cooef2[i][1], FUSION_METHOD)\n","        c3 = fuseCoeff(cooef1[i][2], cooef2[i][2], FUSION_METHOD)\n","\n","        fusedCooef.append((c1,c2,c3))\n","\n","# After we fused the cooefficent we nned to transfor back to get the image\n","fusedImage = pywt.waverec2(fusedCooef, wavelet)\n","\n","fusedImage = (fusedImage - fusedImage.min())/ (fusedImage.max()- fusedImage.min())\n","\n","plt.figure(figsize=(12, 8))\n","plt.title('Visible Channel')\n","plt.imshow(I1, cmap='gray')\n","plt.colorbar(shrink=0.5)\n","\n","plt.figure(figsize=(12, 8))\n","plt.title('Infrared Channel')\n","plt.imshow(I2, cmap='gray')\n","plt.colorbar(shrink=0.5)\n","\n","plt.figure(figsize=(12, 8))\n","plt.title('Fused Imagery')\n","plt.imshow(fusedImage, cmap='gray')\n","plt.colorbar(shrink=0.5)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"junsLPYhx_nc","executionInfo":{"status":"ok","timestamp":1749343933695,"user_tz":360,"elapsed":6300,"user":{"displayName":"Yifan Yang","userId":"02160242489932461871"}},"outputId":"bb19bf40-95fe-4c01-a959-46c21d3390e3"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["<matplotlib.colorbar.Colorbar at 0x7ed03e7ffc90>"]},"metadata":{},"execution_count":4},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x800 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x800 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x800 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["Plot the infused data"],"metadata":{"id":"199-UEIV3eIs"}},{"cell_type":"code","source":["!pip install cartopy --quiet"],"metadata":{"id":"SYrdbuXxbt1g","executionInfo":{"status":"ok","timestamp":1749344859592,"user_tz":360,"elapsed":4661,"user":{"displayName":"Yifan Yang","userId":"02160242489932461871"}},"colab":{"base_uri":"https://localhost:8080/"},"outputId":"a343ef3b-d224-48ed-a0c9-f0f4f3fc1cf1"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m11.7/11.7 MB\u001b[0m \u001b[31m88.8 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[?25h"]}]},{"cell_type":"code","source":["import numpy as np\n","import cartopy.crs as ccrs\n","import matplotlib.pyplot as plt\n","import cartopy.feature as cf\n","\n","import matplotlib.ticker as mticker\n","from cartopy.mpl.gridliner 